# --- Database (libSQL) ---
# Locale: file SQLite. Produzione (Vercel): URL Turso, es. libsql://<db>-<org>.turso.io
DATABASE_URL="file:./local.db"
# Solo per Turso (lascia vuoto in locale)
DATABASE_AUTH_TOKEN=""

# --- Auth.js ---
# Genera con: openssl rand -base64 32
AUTH_SECRET=""
# Necessario dietro proxy non-Vercel; su Vercel è automatico
# AUTH_TRUST_HOST="true"

# --- Anthropic ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
